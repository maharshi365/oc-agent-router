{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "./dist/index.js",
      {
        "models": [
          "openai/gpt-5.6-sol",
          "openai/gpt-5.6-terra",
          "openai/gpt-5.6-luna"
        ],
        "fallbackModel": "openai/gpt-5.6-terra",
        "instructions": "Choose the configured model most suitable for each OpenCode subagent task. Prefer a capable model for implementation, debugging, and complex reasoning; prefer an efficient model for focused exploration or simple tasks. Simple model for trivial instructions",
        "timeoutMs": 5000
      }
    ]
  ]
}
